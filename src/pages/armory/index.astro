---
import Base from "../../layouts/Base.astro";
import { tools, statusLabel, type ToolStatus } from "../../data/tools";

const groups: { key: ToolStatus; title: string; note: string }[] = [
  { key: "online", title: "运行中", note: "正在用，随时可以开" },
  { key: "beta", title: "测试中", note: "能用，但偶尔会崩" },
  { key: "archived", title: "已归档", note: "留着纪念，不再维护" },
];

const grouped = groups.map((g) => ({
  ...g,
  items: tools.filter((t) => t.status === g.key),
}));
---

<Base period="工具柜" description="地球 616 工具柜：自用的小工具与实验性项目。">
  <header class="relative overflow-hidden border-b-[3px] border-[var(--color-ink)] pb-5">
    <div
      class="pointer-events-none absolute -right-8 -top-12 h-44 w-44 halftone dot-fade text-[var(--color-hero)] opacity-[0.1]"
      aria-hidden="true"
    >
    </div>
    <span class="caption rise d1">工具柜 / ARMORY</span>
    <h1 class="display rise d2 mt-3 text-5xl sm:text-7xl">
      武器<span class="text-[var(--color-hero)]">库</span>
    </h1>
    <p class="mt-3 max-w-xl text-sm font-bold leading-relaxed text-[var(--color-ink-soft)]">
      自己写、自己用的小工具。没有一个是给别人用的，所以别指望有文档。
    </p>
    <p class="mt-2 font-mono text-[0.62rem] tracking-[0.18em] text-[var(--color-ink-soft)]">
      MODULES: {String(tools.length).padStart(2, "0")} · STATUS: NOMINAL
    </p>
  </header>

  {
    grouped
      .filter((g) => g.items.length > 0)
      .map((g, gi) => (
        <section class="mt-10">
          <div class="mb-4 flex items-center gap-4">
            <h2 class="display text-3xl">{g.title}</h2>
            <div class="rule-heavy flex-1" />
            <span class="label text-[var(--color-ink-soft)]">{g.note}</span>
          </div>

          <div class="grid gap-5 md:grid-cols-2">
            {g.items.map((t, i) => (
              <a
                href={t.href}
                class={`panel-dark group block rise d${Math.min(i + gi + 2, 6)} transition-transform duration-200 hover:-translate-y-1`}
              >
                <div class="relative z-10 p-5">
                  <div class="flex items-center justify-between">
                    <span class="font-mono text-[0.58rem] tracking-[0.16em] text-[var(--color-hud)]/55">
                      {t.code}
                    </span>
                    <span class="flex items-center gap-1.5">
                      <span
                        class:list={[
                          "h-1.5 w-1.5 rotate-45",
                          t.status === "online" && "bg-[var(--color-hud)]",
                          t.status === "beta" && "bg-[var(--color-reactor)]",
                          t.status === "archived" && "bg-[#6b7b8a]",
                        ]}
                      />
                      <span class="font-mono text-[0.55rem] tracking-[0.12em] text-[var(--color-hud)]/60">
                        {statusLabel[t.status]}
                      </span>
                    </span>
                  </div>

                  <h3 class="display mt-3 text-2xl text-[#e6f6fb] transition-colors group-hover:text-[var(--color-hud)]">
                    {t.name}
                  </h3>
                  <p class="mt-1.5 text-[0.8rem] leading-relaxed text-[var(--color-hud)]/72">
                    {t.desc}
                  </p>

                  <div class="mt-4 flex items-center justify-between border-t border-[var(--color-hud)]/20 pt-3">
                    <span class="border border-[var(--color-hud)]/40 px-1.5 py-0.5 font-mono text-[0.55rem] tracking-[0.1em] text-[var(--color-hud)]/70">
                      {t.tag}
                    </span>
                    <span class="font-mono text-[0.58rem] tracking-[0.14em] text-[var(--color-hud)]/0 transition-opacity group-hover:text-[var(--color-hud)]">
                      打开 →
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
  }

  <section class="mt-12 border-[3px] border-[var(--color-ink)] bg-[var(--color-paper-lo)] p-6">
    <span class="caption">申请接入 / REQUEST</span>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed">
      想加一个新模块？流程是：先写出来自己用两周，用顺了再挂上来。所以这个柜子更新很慢，但放上来的都不会删。
    </p>
    <a href="/dossier" class="btn-616 mt-5 text-sm">找我聊聊 →</a>
  </section>
</Base>
