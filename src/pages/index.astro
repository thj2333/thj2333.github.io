---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { tools, statusLabel } from "../data/tools";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.issue - a.data.issue);

const latest = posts.slice(0, 3);
const total = posts.length;
const letters = ["C", "O", "N", "T", "I", "N", "U", "E", "D"];

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;

const issueNo = (n: number) => String(n).padStart(3, "0");

const liveTools = tools.filter((t) => t.status !== "archived").slice(0, 4);
---

<Base>
  <!-- ═══ 封面 ═══ -->
  <div class="grid gap-5 lg:grid-cols-12">
    <section
      class="panel crop-marks relative overflow-hidden rise d1 lg:col-span-8"
      aria-labelledby="hero-title"
    >
      <div class="hero-art" aria-hidden="true">
        <div class="hero-burst"></div>
        <div class="hero-dots halftone text-[var(--color-hero)]"></div>
        <div class="hero-lines"></div>
      </div>

      <div class="relative z-10 flex h-full flex-col p-6 sm:p-9 lg:p-11">
        <div class="flex flex-wrap items-center gap-3">
          <span class="caption">本期企划 / FEATURE</span>
          <span class="label text-[var(--color-ink-soft)]"
            >VOL.06 — NO.0616</span
          >
        </div>

        <h1 id="hero-title" class="mt-5">
          <span class="display block text-[3.4rem] leading-[0.85] sm:text-[4.6rem]"
            >地球</span
          >
          <span
            class="display ink-outline jump-shadow mt-1 block text-[5.6rem] leading-[0.8] text-[var(--color-hero)] sm:text-[8.2rem]"
            >616</span
          >
        </h1>

        <p
          class="mt-6 max-w-md text-[0.95rem] font-bold leading-relaxed text-[var(--color-ink-soft)]"
        >
          主宇宙档案库。写论文精读，也写踩过的坑；收着几件顺手的小工具。<br />
          每篇文章算一期连载，目前已经印到第 {issueNo(total)} 期。
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="/archive" class="btn-616">
            <span>进入档案库</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/armory" class="btn-616 btn-ghost">
            <span>打开工具柜</span>
            <span aria-hidden="true">⌘</span>
          </a>
        </div>

        <div class="balloon mt-12 max-w-[17rem] -rotate-1 text-sm">
          「欢迎来到主宇宙。别的地方都是分支。」
        </div>

        <div
          class="mt-auto flex flex-wrap items-end justify-between gap-4 border-t-2 border-dashed border-[var(--color-ink)]/40 pt-8"
        >
          <div>
            <p class="label text-[var(--color-ink-soft)]">下一期 / NEXT ISSUE</p>
            <p class="display mt-1 text-3xl text-[var(--color-ink)]/25">
              #{String(total + 1).padStart(3, "0")}
            </p>
          </div>
          <div class="text-right">
            <p class="label text-[var(--color-ink-soft)]">想追更？</p>
            <a
              href="/rss.xml"
              class="display text-xl underline decoration-[3px] decoration-[var(--color-hero)] underline-offset-4 hover:text-[var(--color-hero)]"
              >订阅 RSS ↗</a
            >
          </div>
        </div>
      </div>
    </section>

    <!-- 终端目录 -->
    <aside
      class="panel-dark crop-marks rise d2 lg:col-span-4"
      aria-labelledby="toc-title"
    >
      <div class="relative z-10 flex h-full flex-col p-5">
        <div class="flex items-center justify-between">
          <h2 id="toc-title" class="label text-[var(--color-hud)]">
            TERMINAL / 目录
          </h2>
          <span class="flex items-center gap-1.5 font-mono text-[0.58rem] tracking-[0.18em] text-[var(--color-hud)]/70">
            <span class="h-1.5 w-1.5 bg-[var(--color-hud)] blink"></span>LIVE
          </span>
        </div>

        <div
          class="mt-4 space-y-1 border-y border-[var(--color-hud)]/25 py-3 font-mono text-[0.66rem] leading-relaxed text-[var(--color-hud)]/75"
        >
          <p>&gt; mount /archive ... ok</p>
          <p>&gt; issues loaded: {total}</p>
          <p>&gt; armory modules: {liveTools.length}</p>
          <p class="text-[var(--color-hud)]">&gt; status: NOMINAL_</p>
        </div>

        <ul class="mt-4 space-y-0.5">
          {
            posts.map((p, i) => (
              <li>
                <a
                  href={`/archive/${p.id}`}
                  class="group flex items-baseline gap-3 border-b border-dashed border-[var(--color-hud)]/20 py-2.5 transition-colors hover:border-[var(--color-hud)]"
                >
                  <span class="font-mono text-[0.6rem] text-[var(--color-hud)]/55">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span class="flex-1 text-[0.82rem] font-bold leading-snug transition-colors group-hover:text-[var(--color-hud)]">
                    {p.data.title}
                  </span>
                  <span class="font-mono text-[0.55rem] text-[var(--color-hud)]/40">
                    P{issueNo(p.data.issue)}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mt-auto pt-5">
          <div class="flex items-center gap-4">
            <div class="radar" aria-hidden="true">
              <span class="radar-sweep"></span>
            </div>
            <div class="font-mono text-[0.55rem] leading-relaxed tracking-[0.14em] text-[var(--color-hud)]/45">
              <p>SECTOR 07 / QUEENS</p>
              <p>LAT 40.7 · LON -73.9</p>
              <p class="text-[var(--color-hud)]/70">NO ANOMALY</p>
            </div>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-between border-t border-[var(--color-hud)]/25 pt-3">
          <a
            href="/archive"
            class="font-mono text-[0.62rem] tracking-[0.14em] text-[var(--color-hud)] hover:underline"
            >全部档案 →</a
          >
          <span class="font-mono text-[0.55rem] tracking-[0.16em] text-[var(--color-hud)]/45"
            >EARTH-616</span
          >
        </div>
      </div>
    </aside>
  </div>

  <!-- ═══ 本期连载 ═══ -->
  <div class="mt-10 flex items-end justify-between gap-4">
    <div>
      <span class="caption">本期连载 / IN THIS ISSUE</span>
      <h2 class="display mt-3 text-3xl sm:text-4xl">最近的三期</h2>
    </div>
    <a
      href="/archive"
      class="hidden shrink-0 border-b-2 border-[var(--color-ink)] pb-0.5 font-mono text-[0.68rem] tracking-[0.16em] hover:text-[var(--color-hero)] sm:block"
      >查看全部 {total} 期</a
    >
  </div>

  <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      latest.map((p, i) => (
        <a
          href={`/archive/${p.id}`}
          class={`panel panel-hover group flex flex-col overflow-hidden rise d${i + 2}`}
        >
          <div class="flex items-center justify-between border-b-[3px] border-[var(--color-ink)] bg-[var(--color-reactor)] px-3 py-1.5">
            <span class="font-mono text-[0.62rem] font-bold tracking-[0.16em]">
              ISSUE #{issueNo(p.data.issue)}
            </span>
            <span class="font-mono text-[0.62rem] tracking-[0.1em]">
              {fmt(p.data.date)}
            </span>
          </div>

          <div class="relative flex flex-1 flex-col p-5">
            <div
              class="pointer-events-none absolute right-0 top-0 h-16 w-16 halftone text-[var(--color-ink)] opacity-[0.07]"
              aria-hidden="true"
            />
            <h3 class="display text-[1.35rem] leading-tight transition-colors group-hover:text-[var(--color-hero)]">
              {p.data.title}
            </h3>
            <p class="mt-2.5 flex-1 text-[0.82rem] leading-relaxed text-[var(--color-ink-soft)]">
              {p.data.excerpt}
            </p>
            <div class="mt-4 flex items-center justify-between border-t-2 border-dashed border-[var(--color-ink)]/30 pt-3">
              <span class="label bg-[var(--color-ink)] px-2 py-0.5 text-[var(--color-paper-hi)]">
                {p.data.category}
              </span>
              <span class="font-mono text-[0.62rem] tracking-[0.14em] opacity-0 transition-opacity group-hover:opacity-100">
                阅读 →
              </span>
            </div>
          </div>
        </a>
      ))
    }
  </div>

  <!-- ═══ 工具柜 + 人物档案 ═══ -->
  <div class="mt-10 grid gap-5 lg:grid-cols-12">
    <section
      class="panel-dark rise d4 lg:col-span-7"
      aria-labelledby="armory-title"
    >
      <div class="relative z-10 p-5 sm:p-6">
        <div class="flex items-center justify-between">
          <h2 id="armory-title" class="display text-2xl text-[var(--color-hud)]">
            工具柜
          </h2>
          <span class="font-mono text-[0.58rem] tracking-[0.2em] text-[var(--color-hud)]/60"
            >ARMORY / {String(liveTools.length).padStart(2, "0")}</span
          >
        </div>

        <ul class="mt-4 divide-y divide-[var(--color-hud)]/15">
          {
            liveTools.map((t) => (
              <li>
                <a
                  href={t.href}
                  class="group flex items-center gap-3 py-3 transition-colors hover:bg-[var(--color-hud)]/5"
                >
                  <span class="font-mono text-[0.55rem] tracking-[0.12em] text-[var(--color-hud)]/45">
                    {t.code}
                  </span>
                  <span class="flex-1">
                    <span class="block text-[0.88rem] font-bold text-[#e6f6fb] transition-colors group-hover:text-[var(--color-hud)]">
                      {t.name}
                    </span>
                    <span class="mt-0.5 block text-[0.68rem] leading-relaxed text-[var(--color-hud)]/70">
                      {t.desc}
                    </span>
                  </span>
                  <span class="flex shrink-0 items-center gap-1.5">
                    <span
                      class:list={[
                        "h-1.5 w-1.5 rotate-45",
                        t.status === "online" && "bg-[var(--color-hud)]",
                        t.status === "beta" && "bg-[var(--color-reactor)]",
                        t.status === "archived" && "bg-[#6b7b8a]",
                      ]}
                    />
                    <span class="font-mono text-[0.55rem] tracking-[0.1em] text-[var(--color-hud)]/75">
                      {statusLabel[t.status]}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href="/armory"
          class="mt-4 inline-block border-b-2 border-[var(--color-hud)]/50 pb-0.5 font-mono text-[0.62rem] tracking-[0.16em] text-[var(--color-hud)] hover:border-[var(--color-hud)]"
          >全部工具 →</a
        >
      </div>
    </section>

    <section class="panel rise d5 lg:col-span-5" aria-labelledby="dossier-title">
      <div class="flex items-center justify-between border-b-[3px] border-[var(--color-ink)] bg-[var(--color-cape)] px-4 py-2">
        <span class="label text-[var(--color-paper-hi)]">人物档案 / DOSSIER</span>
        <span class="font-mono text-[0.55rem] tracking-[0.16em] text-[var(--color-paper-hi)]/70">616-A</span>
      </div>

      <div class="p-5">
        <div class="flex items-start gap-4">
          <div class="relative grid h-20 w-20 shrink-0 place-items-center border-[3px] border-[var(--color-ink)] bg-[var(--color-hero)] shadow-[4px_4px_0_0_var(--color-ink)]">
            <span class="display text-2xl text-[var(--color-paper-hi)]">THJ</span>
            <span class="absolute -bottom-2 -right-2 border-2 border-[var(--color-ink)] bg-[var(--color-reactor)] px-1 font-mono text-[0.5rem] font-bold">
              ID
            </span>
          </div>
          <div class="min-w-0">
            <h2 id="dossier-title" class="display text-2xl">thj2333</h2>
            <p class="label mt-1 text-[var(--color-ink-soft)]">开发者 / 学生</p>
            <p class="mt-2 text-[0.78rem] leading-relaxed text-[var(--color-ink-soft)]">
              同时出现在两个宇宙：一个写代码，一个看漫画。
            </p>
          </div>
        </div>

        <dl class="mt-6 space-y-3">
          {
            [
              { k: "代码 / CODE", v: 78, c: "var(--color-cape)" },
              { k: "论文 / PAPERS", v: 64, c: "var(--color-hero)" },
              { k: "咖啡 / COFFEE", v: 91, c: "var(--color-reactor)" },
            ].map((s) => (
              <div class="flex items-center gap-3">
                <dt class="w-28 shrink-0 font-mono text-[0.55rem] tracking-[0.14em] text-[var(--color-ink-soft)]">
                  {s.k}
                </dt>
                <div class="h-3 flex-1 border-2 border-[var(--color-ink)] bg-[var(--color-paper-lo)]">
                  <div class="h-full" style={`width:${s.v}%;background:${s.c}`} />
                </div>
                <dd class="w-8 text-right font-mono text-[0.58rem] font-bold">
                  {s.v}
                </dd>
              </div>
            ))
          }
        </dl>

        <a href="/dossier" class="btn-616 mt-6 w-full justify-center text-sm">
          查看完整档案 →
        </a>
      </div>
    </section>
  </div>

  <!-- ═══ 跑马灯 ═══ -->
  <div class="mt-10 overflow-hidden border-[3px] border-[var(--color-ink)] bg-[var(--color-hero)] py-2 shadow-[7px_7px_0_0_var(--color-ink)]">
    <div class="marquee flex w-max gap-6 whitespace-nowrap">
      {
        [...letters, ...letters].map((c, i) => (
          <span class="flex items-center gap-6">
            <span class="display text-lg text-[var(--color-paper-hi)]">{c}</span>
            <span class="text-[var(--color-paper-hi)]/60">•</span>
          </span>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .hero-art {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-burst {
    position: absolute;
    right: -18%;
    top: -38%;
    width: 620px;
    height: 620px;
    background: repeating-conic-gradient(
      from 0deg,
      rgba(242, 169, 0, 0.55) 0deg 5deg,
      rgba(242, 169, 0, 0) 5deg 11deg
    );
    mask-image: radial-gradient(circle at center, #000 0 58%, transparent 60%);
    animation: hero-spin 90s linear infinite;
  }

  .hero-dots {
    position: absolute;
    right: -60px;
    bottom: -70px;
    width: 340px;
    height: 340px;
    border-radius: 999px;
    opacity: 0.13;
    mask-image: radial-gradient(circle at center, #000 0 62%, transparent 68%);
  }

  .hero-lines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(20, 17, 14, 0.05) 0 1px,
      transparent 1px 4px
    );
    mask-image: linear-gradient(to bottom, transparent 40%, #000 100%);
  }

  @keyframes hero-spin {
    to {
      rotate: 360deg;
    }
  }

  .marquee {
    animation: marquee 26s linear infinite;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .radar {
    position: relative;
    width: 68px;
    height: 68px;
    flex: none;
    border-radius: 999px;
    border: 1px solid rgba(35, 224, 255, 0.35);
    background:
      repeating-radial-gradient(
        circle at center,
        transparent 0 10px,
        rgba(35, 224, 255, 0.16) 10px 11px
      ),
      linear-gradient(rgba(35, 224, 255, 0.12), rgba(35, 224, 255, 0.12)) 50% 50% / 1px 100% no-repeat,
      linear-gradient(90deg, rgba(35, 224, 255, 0.12), rgba(35, 224, 255, 0.12)) 50% 50% / 100% 1px no-repeat;
    overflow: hidden;
  }

  .radar-sweep {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: conic-gradient(
      from 0deg,
      rgba(35, 224, 255, 0.55),
      rgba(35, 224, 255, 0) 55deg
    );
    animation: radar-spin 4.5s linear infinite;
  }

  @keyframes radar-spin {
    to {
      rotate: 360deg;
    }
  }

  @media (max-width: 640px) {
    .hero-burst {
      width: 420px;
      height: 420px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-burst,
    .marquee,
    .radar-sweep {
      animation: none;
    }
  }
</style>
